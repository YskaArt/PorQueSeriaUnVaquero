<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <application>

    <!-- Play Games Services - project app id (usa string resource) -->
    <meta-data
        android:name="com.google.android.gms.games.APP_ID"
        tools:replace="android:value"
        android:value="@string/app_id" />

    <!-- Google Play services version check (normalmente provisto por la dependencia) -->
    <meta-data
        android:name="com.google.android.gms.version"
        tools:replace="android:value"
        android:value="@integer/google_play_services_version" />

    <!-- Nearby Connections SERVICE_ID (usás Nearby según lo que indicás) -->
    <meta-data
        android:name="com.google.android.gms.nearby.connection.SERVICE_ID"
        android:value="com.HKEntertainment.CowboyIdleFrontier" />

    <!--Used when Application Entry is set to Activity, otherwise remove this activity block-->
    <activity android:name="com.unity3d.player.UnityPlayerActivity"
              android:theme="@style/UnityThemeSelector">
      <!-- Quité el intent-filter MAIN/LAUNCHER de esta activity para evitar tener dos launchers -->
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
    </activity>

    <!--Used when Application Entry is set to GameActivity, otherwise remove this activity block-->
    <activity android:name="com.unity3d.player.UnityPlayerGameActivity"
              android:theme="@style/BaseUnityGameActivityTheme">
      <!-- Dejé esta activity como LAUNCHER por defecto -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
      <meta-data android:name="android.app.lib_name" android:value="game" />
    </activity>

  </application>
</manifest>
